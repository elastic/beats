[!windows] skip 'requires Windows'

write-event 'Hello world!'
wait-for-event-log 1

# A second event log that stops early must not stop the first one. It reads
# the same channel under its own id, drops every event with its event_id
# filter, and stops at the end of the channel (no_more_events: stop).
# The process is expected to fail only because it is killed below. Killing a
# process that has already exited is an error, so this also checks that
# winlogbeat was still running.
! exec winlogbeat -c winlogbeat.yml --path.data $WORK/data &
wait-for-event-count output 1
check-event-field output 0 message 'Hello world!'

# Give a wrongly stopping winlogbeat time to exit, so kill finds it dead and fails.
sleep 5s
kill
wait

-- winlogbeat.yml --
winlogbeat.shutdown_timeout: 30s
winlogbeat.event_logs:
  - name: ${PROVIDER:?missing PROVIDER}
  - name: ${PROVIDER:?missing PROVIDER}
    id: stops-early
    event_id: '4242'
    no_more_events: stop
output.file:
  path: ${WORK:?missing WORK}/output
  filename: winlogbeat
  rotate_every_kb: 10000
queue.mem:
  events: 4096
  flush.min_events: 1
  flush.timeout: 0.1s
logging.level: warning
logging.to_files: false
